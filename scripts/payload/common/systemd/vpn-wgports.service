[Unit]
Description=Accept WireGuard clients on udp/443 as well (for networks that drop high ports)
After=network-online.target nftables.service wg-quick@wg-clients.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/xray/wgports.nft
ExecStop=/bin/sh -c '/usr/sbin/nft delete table ip wgports || true'

[Install]
WantedBy=multi-user.target
