[Unit]
Description=Tunnel watchdog: probe, repair, failover to the fallback route, notifications
After=network-online.target xray.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/vpn-watchdog.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
